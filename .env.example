# Spiral OS environment. Copy to .env.local for local development.
# Every integration is optional: a section without its source shows sample data.

# --- App -------------------------------------------------------------------
# Public URL of the app on Railway, e.g. https://spiral-os.up.railway.app (no trailing path).
# The Google OAuth client needs "<APP_URL>/api/google/callback" as an authorized redirect URI
# (locally: http://localhost:3000/api/google/callback).
APP_URL=
# Calendar dates and "today" are New York time.
TIMEZONE=America/New_York

# --- Database (Supabase Postgres) ------------------------------------------
# Leave empty locally: an embedded Postgres in .data/pglite is used and migrated automatically.
# On Railway: in Supabase click Connect > Session pooler, and put the database password in the string
# (percent-encode characters like @ in it). TLS to Supabase is verified automatically.
DATABASE_URL=

# --- Sign-in (Supabase Auth) ------------------------------------------------
# Supabase > Project settings > API. Leave empty locally to use the dev-only session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secrets ----------------------------------------------------------------
# 32 random bytes as 64 hex characters: `openssl rand -hex 32`. Encrypts stored Google tokens.
APP_ENCRYPTION_KEY=
# Secret for the background routes (/api/cron/sync, /api/cron/warm), which the server's own daily
# schedule calls: `openssl rand -hex 24`. Without it there is no daily sync or cache warm-up.
CRON_SECRET=

# --- Google (OAuth app in the outreachify.io Workspace, user type "Internal") ---
# Enable these APIs on the Google Cloud project: Google Analytics Data API, Google Search Console API,
# Google Sheets API, Gmail API. Then an OpsLabs user presses "Connect Google" on the Analytics page and
# signs in as GOOGLE_ACCOUNT_EMAIL (read-only scopes; the refresh token is stored encrypted).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed to connect (admin@outreachify.io). Spiral OS can read what it can read.
GOOGLE_ACCOUNT_EMAIL=
# Spiral NY's lead sheet ID (from its docs.google.com/spreadsheets/d/<ID>/ link).
LEAD_SHEET_ID=
# GA4 property ID (numbers only), from Admin > Property details.
GA4_PROPERTY_ID=
# Search Console property (e.g. sc-domain:spiralny.com). Optional: leave empty to pick the spiralny.com property the account can read.
GSC_SITE_URL=
# Gmail search that finds the WPForms "Spiral OS" notification emails in that account's inbox.
GMAIL_FORMS_QUERY=subject:"Spiral OS entry"

# --- Instantly ----------------------------------------------------------------
# API v2 key from Spiral NY's workspace (scope all:read).
INSTANTLY_API_KEY=

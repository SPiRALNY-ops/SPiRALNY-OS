# Spiral OS environment. Copy to .env.local for local development.
# Every integration is optional: a section without its source shows sample data.

# --- App -------------------------------------------------------------------
# Public URL of the app on Railway (used for the Google sign-in redirect).
APP_URL=
# Calendar dates and "today" are New York time.
TIMEZONE=America/New_York

# --- Database (Supabase Postgres) ------------------------------------------
# Leave empty locally: an embedded Postgres in .data/pglite is used and migrated automatically.
# On Railway: Supabase > Project settings > Database > Connection string (session pooler or direct).
DATABASE_URL=

# --- Sign-in (Supabase Auth) ------------------------------------------------
# Supabase > Project settings > API. Leave empty locally to use the dev-only session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secrets ----------------------------------------------------------------
# 32 random bytes as 64 hex characters: `openssl rand -hex 32`. Encrypts stored Google tokens.
APP_ENCRYPTION_KEY=
# Shared secret for the Railway cron service calling /api/cron/sync: `openssl rand -hex 24`.
CRON_SECRET=

# --- Google (OAuth app in the outreachify.io Workspace, user type "Internal") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GA4 property ID (numbers only), from Admin > Property details.
GA4_PROPERTY_ID=
# Search Console property. Domain property format: sc-domain:spiralny.com
GSC_SITE_URL=sc-domain:spiralny.com
# Gmail search that finds the WPForms "Spiral OS" notification emails in admin@outreachify.io.
GMAIL_FORMS_QUERY=subject:"Spiral OS entry"

# --- Instantly ----------------------------------------------------------------
# API v2 key from Spiral NY's workspace (scope all:read).
INSTANTLY_API_KEY=
